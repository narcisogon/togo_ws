<?xml version="1.0"?>
<sdf version='1.9'>
  <world name='apollo16_test'>

    <physics name='1ms' type='ignored'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name='gz::sim::systems::Physics'          filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands'     filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact'          filename='gz-sim-contact-system'/>

    <gravity>0 0 -1.62</gravity>

    <scene>
      <ambient>0.3 0.3 0.35 1</ambient>
      <background>0.05 0.05 0.05 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Lunar sunlight -->
    <light name='sun' type='directional'>
      <pose>0 0 100 0 -0.3 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>2.0</intensity>
      <direction>-0.3 0.1 -0.9</direction>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
      <attenuation>
        <range>10000</range>
        <linear>0.01</linear>
        <constant>0.9</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- Apollo 16 NAC DTM Terrain -->
    <model name='apollo16_terrain'>
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name='link'>

        <collision name='collision'>
          <geometry>
            <heightmap>
              <uri>file:///home/er4-user/ws/src/togo/togo_gz/media/dem/NAC_DTM_APOLLO16_2049.tif</uri>
              <size>4098 4098 939</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </collision>

        <visual name='visual'>
          <geometry>
            <heightmap>
              <uri>file:///home/er4-user/ws/src/togo/togo_gz/media/dem/NAC_DTM_APOLLO16_2049.tif</uri>
              <size>4098 4098 939</size>
              <pos>0 0 0</pos>
              <texture>
                <diffuse>file:///home/er4-user/ws/src/togo/togo_gz/media/dem/NAC_DTM_APOLLO16_slipmap.tif</diffuse>
                <size>10</size>
              </texture>
            </heightmap>
          </geometry>
        </visual>

      </link>
    </model>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 -500 500 0 0.7 1.57</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

  </world>
</sdf>
