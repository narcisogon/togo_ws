<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- lidar360 (2026-11-01, the mast test): a 360-degree LiDAR, the Ouster OS1-64 model of
       clearpath_sensors_description (1024 x 64 rays, 360 x 42.4 deg, 20 Hz), on a mast standing at the centre of
       the sensor arch's top, in addition to the front Seyond. Off by default; the simulation launcher passes
       extra_xacro_args:="lidar360:=true lidar360_mast:=0.40" (mast length in m). Its cloud is bridged to
       /husky/sensors/ouster/points (togo_gz/config/bridge.yaml); the sensor frame is lidar360_0_sensor_link. -->
  <xacro:arg name="lidar360" default="false"/>
  <xacro:arg name="lidar360_mast" default="0.40"/>

  <xacro:macro name="togo">

  <!-- Common -->
  <xacro:include filename="$(find clearpath_platform_description)/urdf/common.urdf.xacro"/>

  <!-- Platform -->
  <xacro:include filename="$(find togo_description)/urdf/a300/a300.urdf.xacro"/>
  <xacro:a300 control="diff_4wd" front_wheels="outdoor" rear_wheels="outdoor"/>

  <!-- Attachments -->

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/bumper.urdf.xacro"/>
  <xacro:bumper name="front_bumper" model="default" parent_link="front_bumper_mount" extension="0.0">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </xacro:bumper>

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/bumper.urdf.xacro"/>
  <xacro:bumper name="rear_bumper" model="default" parent_link="rear_bumper_mount" extension="0.0">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </xacro:bumper>

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/amp_enclosure.urdf.xacro"/>
  <xacro:amp_enclosure name="enclosure" model="amp_enclosure" parent_link="base_link">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </xacro:amp_enclosure>

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/amp_sensor_arch.urdf.xacro"/>
  <xacro:amp_sensor_arch name="sensor_arch" model="amp_sensor_arch" parent_link="enclosure_antenna_mount">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </xacro:amp_sensor_arch>

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/spotlight.urdf.xacro"/>
  <xacro:spotlight name="driving_light_1" model="spotlight" parent_link="sensor_arch_front_left_corner_mount">
    <origin xyz="0.0 0.0 -0.08" rpy="0.0 0.5235987755982988 0.5235987755982988"/>
  </xacro:spotlight>

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/spotlight.urdf.xacro"/>
  <xacro:spotlight name="driving_light_2" model="spotlight" parent_link="sensor_arch_front_right_corner_mount">
    <origin xyz="0.0 0.0 -0.08" rpy="0.0 0.5235987755982988 -0.5235987755982988"/>
  </xacro:spotlight>

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/spotlight.urdf.xacro"/>
  <xacro:spotlight name="driving_light_3" model="spotlight" parent_link="sensor_arch_rear_left_corner_mount">
    <origin xyz="0.0 0.0 -0.08" rpy="0.0 0.5235987755982988 -0.5235987755982988"/>
  </xacro:spotlight>

  <xacro:include filename="$(find clearpath_platform_description)/urdf/a300/attachments/spotlight.urdf.xacro"/>
  <xacro:spotlight name="driving_light_4" model="spotlight" parent_link="sensor_arch_rear_right_corner_mount">
    <origin xyz="0.0 0.0 -0.08" rpy="0.0 0.5235987755982988 0.5235987755982988"/>
  </xacro:spotlight>


  <!-- Links -->


  <!-- Mounts -->


  <!-- Sensors -->

  <!-- lidar3d_0 -->
  <xacro:include filename="$(find clearpath_sensors_description)/urdf/seyond_lidar.urdf.xacro"/>
  <xacro:seyond_lidar name="lidar3d_0" parent_link="enclosure_front_lidar_mount" ang_res_h="0.01" ang_res_v="0.01" min_ang_h="-1.0471975511965976" max_ang_h="1.0471975511965976" min_ang_v="-0.6108652381980153" max_ang_v="0.6108652381980153" min_range="0.1" max_range="150.0" update_rate="20">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </xacro:seyond_lidar>

  <!-- lidar360_0: the mast and the 360-degree LiDAR on it (see the arguments at the top of this file) -->
  <xacro:if value="$(arg lidar360)">
    <xacro:property name="lidar360_mast" value="$(arg lidar360_mast)"/>
    <xacro:property name="lidar360_mast_radius" value="0.025"/>
    <xacro:include filename="$(find clearpath_sensors_description)/urdf/ouster_os1.urdf.xacro"/>
    <link name="lidar360_mast_link">
      <inertial>
        <mass value="0.5"/>
        <origin xyz="0 0 ${lidar360_mast / 2}"/>
        <inertia ixx="${0.5 / 12 * (3 * lidar360_mast_radius**2 + lidar360_mast**2)}" ixy="0" ixz="0"
                 iyy="${0.5 / 12 * (3 * lidar360_mast_radius**2 + lidar360_mast**2)}" iyz="0"
                 izz="${0.5 / 2 * lidar360_mast_radius**2}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${lidar360_mast / 2}"/>
        <geometry><cylinder radius="${lidar360_mast_radius}" length="${lidar360_mast}"/></geometry>
        <material name="lidar360_mast_grey"><color rgba="0.4 0.4 0.4 1.0"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${lidar360_mast / 2}"/>
        <geometry><cylinder radius="${lidar360_mast_radius}" length="${lidar360_mast}"/></geometry>
      </collision>
    </link>
    <joint name="lidar360_mast_joint" type="fixed">
      <parent link="sensor_arch_link"/>
      <child link="lidar360_mast_link"/>
      <origin xyz="0 0 0.44536" rpy="0 0 0"/>   <!-- the centre of the arch's top plane -->
    </joint>
    <link name="lidar360_mast_top"/>
    <joint name="lidar360_mast_top_joint" type="fixed">
      <parent link="lidar360_mast_link"/>
      <child link="lidar360_mast_top"/>
      <origin xyz="0 0 ${lidar360_mast}" rpy="0 0 0"/>
    </joint>
    <xacro:ouster_os1 name="lidar360_0" parent_link="lidar360_mast_top" update_rate="20" min_range="0.3" max_range="150.0">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:ouster_os1>
  </xacro:if>
  -->

<!-- Test - CPU LiDAR ->
<gazebo reference="base_link">
  <sensor name="test_lidar" type="lidar">
    <lidar>
      <scan>
        <horizontal>
          <samples>640</samples>
          <resolution>1</resolution>
          <min_angle>-1.396263</min_angle>
          <max_angle>1.396263</max_angle>
        </horizontal>
        <vertical>
          <samples>1</samples>
          <resolution>1</resolution>
          <min_angle>0</min_angle>
          <max_angle>0</max_angle>
        </vertical>
      </scan>
      <range>
        <min>0.10</min>
        <max>30.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
    <always_on>1</always_on>
    <update_rate>10</update_rate>
    <visualize>false</visualize>
    <topic>scan</topic>
  </sensor>
</gazebo>
-->
  <!-- camera_0 ->
  <xacro:include filename="$(find clearpath_sensors_description)/urdf/luxonis_oakd.urdf.xacro"/>
  <xacro:luxonis_oakd name="camera_0" parent_link="sensor_arch_front_camera_mount" update_rate="30.0" model="pro">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </xacro:luxonis_oakd>
-->
  <!-- camera_1 ->
  <xacro:include filename="$(find clearpath_sensors_description)/urdf/luxonis_oakd.urdf.xacro"/>
  <xacro:luxonis_oakd name="camera_1" parent_link="sensor_arch_rear_camera_mount" update_rate="30.0" model="pro">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </xacro:luxonis_oakd>
-->
  <!-- imu_0 -->
  <xacro:include filename="$(find clearpath_sensors_description)/urdf/phidgets_spatial.urdf.xacro"/>
  <xacro:phidgets_spatial name="imu_0" parent_link="base_link">
    <origin xyz="0.059 0.0 0.161275" rpy="0.0 0.0 0.0"/>
  </xacro:phidgets_spatial>
  <!-- stereo_rig: generic global-shutter stereo pair (20 cm baseline, 90 deg HFOV, 640x480 mono, 20 fps) with its own
       400 Hz IMU, for visual-inertial odometry. On a front bracket above the LiDAR, level, looking forward: the
       arch's camera mount sits 0.33 m behind the base origin, where the enclosure fills the bottom of the view -->
  <xacro:include filename="$(find togo_description)/urdf/stereo_vio_rig.urdf.xacro"/>
  <xacro:stereo_vio_rig name="stereo_rig" parent_link="base_link">
    <origin xyz="0.45 0.0 0.50" rpy="0.0 0.0 0.0"/>
  </xacro:stereo_vio_rig>

  <!-- ins_0 -->
  <xacro:include filename="$(find clearpath_sensors_description)/urdf/fixposition.urdf.xacro"/>
  <xacro:fixposition name="ins_0" parent_link="enclosure_ins_mount" num_antennas="2" gps_0_type="spherical" gps_0_xyz_x="0.0" gps_0_xyz_y="0.0" gps_0_xyz_z="0.0" gps_0_rpy_r="0.0" gps_0_rpy_p="0.0" gps_0_rpy_y="0.0" gps_0_parent="sensor_arch_right_antenna_mount" gps_1_type="spherical" gps_1_xyz_x="0.0" gps_1_xyz_y="0.0" gps_1_xyz_z="0.0" gps_1_rpy_r="0.0" gps_1_rpy_p="0.0" gps_1_rpy_y="0.0" gps_1_parent="sensor_arch_left_antenna_mount">
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </xacro:fixposition>


  <!-- Manipulators -->


  <!-- Extras -->

  </xacro:macro>
</robot>
