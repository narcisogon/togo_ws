<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>togo_deploy</name>
  <version>0.0.0</version>
  <description>Deploy package for Clearpath Husky known as Togo</description>
  <maintainer email="emily.j.sheetz@nasa.gov">Emily Sheetz</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <depend>seyond</depend>
  <depend>fixposition_driver_ros2</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>clearpath_desktop</exec_depend>
  <exec_depend>clearpath_common</exec_depend>
  <exec_depend>clearpath_robot</exec_depend>
  <exec_depend>depthai-ros</exec_depend>
  <exec_depend>phidgets_spatial</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
